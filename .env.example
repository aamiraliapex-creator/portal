# ---- Database (Neon / Vercel Postgres / any PostgreSQL) --------------------
# Pooled connection used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Direct (unpooled) connection used by `npm run db:setup` for DDL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Session signing key (REQUIRED, >= 32 chars) ---------------------------
# The app refuses to start a session if this is missing or too short.
# Generate with: openssl rand -base64 48
AUTH_SECRET=""

# ---- First administrator (used ONLY by `npm run db:setup`) -----------------
# Remove SUPERADMIN_PASSWORD from the environment after the first sign-in.
SUPERADMIN_NAME="System Owner"
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
